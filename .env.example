# StoreToStove Environment Variables
# Copy this to .env and fill in your values

# ============================================
# DATABASE (Server-side only)
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/storetostove"

# ============================================
# AUTHENTICATION (Server-side only)
# ============================================
# Google OAuth - Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET=""

# ============================================
# AI/LLM API Keys (Server-side only - NEVER prefix with NEXT_PUBLIC_)
# ============================================
# Anthropic Claude API - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# OpenAI (if needed)
# OPENAI_API_KEY=""

# ============================================
# EXTERNAL APIs (Server-side only)
# ============================================
# Grocery store API keys (if applicable)
# Add your grocery/price comparison API keys here

# ============================================
# APPLICATION CONFIG
# ============================================
# Backend URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

NODE_ENV=development
PORT=3001
